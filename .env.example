# Copy to .env (never commit .env)

# Django settings
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
REGISTER_THROTTLE_RATE=20/hour

# Database. Matches the db service in docker-compose.yml.
# Leave DATABASE_URL empty to use SQLite (backend/db.sqlite3) - the Django migrations
# create the tables. A database initialised from db/schema.sql already has the tables,
# so `manage.py migrate` cannot run against it until the models and schema.sql are aligned.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lawaid

# Document Encryption Key (Fernet AES-128-CBC + HMAC-SHA256 authenticated symmetric key)
DOCUMENT_ENCRYPTION_KEY=c1nwgexw36iltaDC_aCA64MHK2AkBmvxoJK0YdQ4GZY=

# Login tokens (Saker, SYS-19). Optional - defaults to SECRET_KEY.
JWT_SIGNING_KEY=change-me-to-another-long-random-string
# Alternative to DATABASE_URL (Saker's settings): DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT

# Password recovery e-mail (Mashruba, SYS-20). In development e-mails are printed to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@lawaid.local
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
